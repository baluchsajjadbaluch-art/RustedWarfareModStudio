    <string name="feature_archive">مدیریت ZIP / RWMOD</string>
    <string name="feature_archive_desc">مرور و ویرایش داخل آرشیو، افزودن/حذف/استخراج بدون باز کردن بسته</string>
    <string name="feature_editor">ویرایشگر کد و INI</string>
    <string name="feature_editor_desc">رنگ‌آمیزی دستور زبان، جست‌وجو و جایگزینی، واگرد/ازنو، چند تب، جست‌وجوی کل پروژه</string>
